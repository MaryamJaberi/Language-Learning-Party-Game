rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'm.jaberi1212@gmail.com'
      );
    }

    // User profile and private game matches
    match /users/{userId} {
      allow read, write: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
      
      match /matches/{matchId} {
        allow read, write: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
      }

      match /weak_cards/{cardId} {
        allow read, write: if (isSignedIn() && request.auth.uid == userId) || isAdmin();
      }
    }

    // Public Leaderboard for single-player & multiplayer achievements
    match /leaderboard/{entryId} {
      allow read, write: if true;
    }

    // Multiplayer game rooms for remote / Discord / Meet play
    match /rooms/{roomId} {
      allow read, write: if true;
    }
  }
}
